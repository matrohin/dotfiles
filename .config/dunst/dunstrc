# Dunst Configuration - Nord Theme

[global]
    ### Display ###
    monitor = 0
    follow = mouse

    ### Geometry ###
    width = (300, 400)
    height = 300
    origin = top-right
    offset = 20x60
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 0

    ### Border and corners ###
    indicate_hidden = yes
    transparency = 10
    separator_height = 2
    padding = 15
    horizontal_padding = 15
    text_icon_padding = 0
    frame_width = 1
    frame_color = "#88c0d0"
    gap_size = 8
    separator_color = frame

    corner_radius = 0

    ### Text ###
    font = JetBrainsMono Nerd Font 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_corner_radius = 0

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc/Advanced ###
    dmenu = /usr/bin/dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    ### Mouse ###
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

### Urgency presets - Nord colors ###

[urgency_low]
    background = "#2e3440"
    foreground = "#d8dee9"
    frame_color = "#88c0d0"
    timeout = 4
    icon = dialog-information

[urgency_normal]
    background = "#3b4252"
    foreground = "#eceff4"
    frame_color = "#88c0d0"
    timeout = 8
    icon = dialog-information

[urgency_critical]
    background = "#2e3440"
    foreground = "#bf616a"
    frame_color = "#bf616a"
    timeout = 0
    icon = dialog-warning

### Custom rules ###

[spotify]
    appname = Spotify
    urgency = low
    frame_color = "#a3be8c"
    timeout = 5

[discord]
    appname = discord
    urgency = normal
    frame_color = "#81a1c1"

[volume]
    summary = "Volume*"
    urgency = low
    frame_color = "#88c0d0"
    timeout = 2

[brightness]
    summary = "Brightness*"
    urgency = low
    frame_color = "#ebcb8b"
    timeout = 2

[battery]
    appname = "Power Manager"
    urgency = critical
    frame_color = "#bf616a"
